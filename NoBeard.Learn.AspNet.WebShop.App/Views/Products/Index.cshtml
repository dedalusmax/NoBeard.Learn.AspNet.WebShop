@using NoBeard.Learn.AspNet.WebShop.App.Areas.Admin.Models

@model IEnumerable<ProductViewModel>

@{
    ViewData["Title"] = "Product list";
}

<h1>@ViewData["Title"]</h1>

<div class="row mb-5">
    <div class="col-2">
        <div class="dropdown">
            <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                Filter by category
            </button>
            <ul class="dropdown-menu">
                @foreach (var category in ViewBag.Categories)
                {
                    <li><a class="dropdown-item" asp-action="Index" asp-route-categoryId="@category.Value">@category.Text</a></li>
                }
            </ul>
        </div>
    </div>
    <div class="col-2">
        <a asp-action="Index" class="btn btn-warning">Reset filter</a>
    </div>
</div>

<div class="row mt-3">
    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-3">
            <div class="card h-100">
                @if (!string.IsNullOrEmpty(item.FileContentBase64))
                {
                    <img src="data:image;base64,@item.FileContentBase64" class="card-img-top" alt="@item.FileName" style="max-height: 200px; object-fit: cover;">
                }
                else
                {
                    <img src="favicon.ico" class="card-img-top" alt="No image available">
                }
                <div class="card-body">
                    <h5 class="card-title">@item.Name</h5>
                    <p class="card-text">@item.Description</p>
                    <hr/>
                    <label>Price:</label>
                    <p class="card-text">@item.Price.ToString("C")</p>
                    <form asp-controller="Cart" asp-action="AddToCart" method="POST">
                        <input type="hidden" name="productId" asp-for="@item.Id" />
                        <input type="submit" value="Add to cart" class="btn btn-success" />
                    </form>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}