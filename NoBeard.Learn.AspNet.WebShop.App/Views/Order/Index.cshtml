@model Order

@{
    ViewData["Title"] = "Order";
}

<div class="text-center mb-3">
    <h1 class="display-4">Place your order</h1>
</div>
<hr />
<div class="container">
    <div class="row mt-3">
        <div class="text-center">
            <h3>Cart items</h3>
        </div>
        <table class="table">
            <thead>
                <tr>
                    <th></th>
                    <th>Product</th>
                    <th>Price</th>
                    <th>Quantity</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in ViewBag.Cart.Items)
                {
                    <tr>
                        <td>
                            <a class="btn btn-sm btn-danger">Remove</a>
@*                             <form asp-action="RemoveFromCart" method="POST">
                                <input type="hidden" name="productId" asp-for="@item.Product.Id" />
                                <input type="submit" value="Remove" class="btn btn-sm btn-danger" />
                            </form> *@
                        </td>
                        <td>@item.Product.Name</td>
                        <td>@item.Product.Price.ToString("C")</td>
                        <td>@item.Quantity</td>
                        <td>@item.Total.ToString("C")</td>
                    </tr>
                }
                <tr>
                    <td colspan="4" class="text-right"><strong>Total:</strong></td>
                    <td>@ViewBag.Cart.GrandTotal.ToString("C")</td>
                </tr>
            </tbody>
        </table>

    </div>
    <div class="row mt-3">
        <div class="text-center">
            <h3>Personal information</h3>
        </div>
        <form asp-action="Create" method="POST">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row">
                <div class="col form-group">
                    <label asp-for="CustomerFirstName" class="control-label"></label>
                    <input asp-for="CustomerFirstName" class="form-control" />
                    <span asp-validation-for="CustomerFirstName" class="text-danger"></span>
                </div>
                <div class="col form-group">
                    <label asp-for="CustomerLastName" class="control-label"></label>
                    <input asp-for="CustomerLastName" class="form-control" />
                    <span asp-validation-for="CustomerLastName" class="text-danger"></span>
                </div>
            </div>
            <div class="row">
                <div class="col form-group">
                    <label asp-for="CustomerEmailAddress" class="control-label"></label>
                    <input type="email" asp-for="CustomerEmailAddress" class="form-control" />
                    <span asp-validation-for="CustomerEmailAddress" class="text-danger"></span>
                </div>
                <div class="col form-group">
                    <label asp-for="CustomerPhoneNumber" class="control-label"></label>
                    <input type="tel" asp-for="CustomerPhoneNumber" class="form-control" />
                    <span asp-validation-for="CustomerPhoneNumber" class="text-danger"></span>
                </div>
            </div>
            <div class="row form-group">
                <label asp-for="CustomerAddress" class="control-label"></label>
                <input type="text" asp-for="CustomerAddress" class="form-control" />
                <span asp-validation-for="CustomerAddress" class="text-danger"></span>
            </div>
            <div class="row">
                <div class="form-group mt-4">
                    <a class="btn btn-outline-danger" asp-controller="Cart" asp-action="Index">Back to Cart</a>
                    <input type="submit" value="Place order" class="btn btn-primary float-end" />
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
