@model IEnumerable<ProductCategory>

@{
    ViewData["Title"] = "Product Categories";
}

<h1>Product Categories</h1>

<p>
    <a asp-action="Create" asp-route-productId="@ViewBag.ProductId">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Product)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Category)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Product.Name)
            </td>
            <td>
                @Html.DisplayFor(model => item.Category.Name)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" asp-route-productId="@ViewBag.ProductId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id" asp-route-productId="@ViewBag.ProductId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id" asp-route-productId="@ViewBag.ProductId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

<a asp-controller="Products" asp-action="Index">Back to Products</a>