@model NoBeard.Learn.AspNet.WebShop.App.Models.Order

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Order</h4>
    <hr />

    <table class="table">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.CustomerFirstName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.CustomerLastName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.CustomerEmailAddress)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.CustomerPhoneNumber)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.CustomerAddress)
                </th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>
                    @Html.DisplayFor(model => model.CustomerFirstName)
                </td>
                <td>
                    @Html.DisplayFor(model => model.CustomerLastName)
                </td>
                <td>
                    @Html.DisplayFor(model => model.CustomerEmailAddress)
                </td>
                <td>
                    @Html.DisplayFor(model => model.CustomerPhoneNumber)
                </td>
                <td>
                    @Html.DisplayFor(model => model.CustomerAddress)
                </td>
            </tr>
        </tbody>
    </table>

    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.DateTimeCreated)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DateTimeCreated)
        </dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Total)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Total)
        </dd>
    </dl>

    <table class="table">
        <thead>
            <tr>
                <th>
                    Product
                </th>
                <th>
                    Quantity
                </th>
                <th>
                    Total
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.ProductName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Quantity)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Total)
                    </td>
                </tr>
            }
        </tbody>

    </table>

</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
